{
  "name": "cloud-init-webgeniso",
  "version": "0.0.0",
  "private": true,
  "description": "Generate cloud-init NoCloud seed ISO images in the browser",
  "license": "AGPL-3.0-or-later",
  "author": "Kenji Gaillac",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
