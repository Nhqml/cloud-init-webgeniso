{
  "name": "cloud-init-webgeniso",
  "version": "0.0.0",
  "private": true,
  "description": "Generate cloud-init NoCloud seed ISO images in the browser",
  "license": "AGPL-3.0-or-later",
  "author": "Kenji Gaillac",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\"",
    "test:integration": "for test in tests/integration/test_*.py; do \"$test\" || exit 1; done",
    "check:headers": "scripts/check_license_headers.py"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
